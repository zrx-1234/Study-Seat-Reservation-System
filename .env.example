# ====================================================================
# 部署环境变量示例
# 复制为 .env 文件并修改为强密码后再启动 docker compose
# 切勿将真实 .env 文件提交到 Git！
# ====================================================================

# ---------- Web 端口 ----------
# Nginx 对外暴露端口，默认 80（HTTP）
HTTP_PORT=80

# ---------- Flask 密钥 ----------
# 请用以下命令生成强密钥：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-me-to-a-long-random-string
JWT_SECRET_KEY=please-change-me-to-another-long-random-string

# ---------- MySQL ----------
DB_ROOT_PASSWORD=please-change-this-root-password
DB_NAME=seat_reservation
DB_USER=ssr_user
DB_PASSWORD=please-change-this-user-password
