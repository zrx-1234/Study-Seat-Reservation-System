# AI模块 - LLM配置

# LLM提供商选择: mock | openai
# 说明：当前代码仅实现 mock/openai，Claude 暂未实现。
LLM_PROVIDER=mock

# 功能开关
# 意图识别现在始终优先调用 LLM；若 LLM 调用失败，会自动降级到关键词规则。

# USE_LLM_REPLY:
#   false - 使用本地模板回复，稳定且无需外部API
#   true  - 在支持的场景下调用真实LLM生成回复
USE_LLM_REPLY=false

# OpenAI配置（LLM_PROVIDER=openai 时使用）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_BASE_URL=https://api.openai.com/v1

# 会话配置
SESSION_STORE_TYPE=memory
# SESSION_STORE_TYPE=redis
# REDIS_URL=redis://localhost:6379/1

SESSION_MAX_HISTORY=20
SESSION_EXPIRE_SECONDS=3600

# 限流配置
AI_RATE_LIMIT_PER_USER=30
AI_RATE_LIMIT_WINDOW=60
